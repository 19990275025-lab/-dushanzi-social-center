{
  "manifest_version": 3,
  "name": "独山子新媒体中心 · 抖音采集器",
  "version": "1.0.0",
  "description": "从当前已登录的抖音作品管理页提取可见作品数据，并导出标准 JSON 供新媒体智能采集中心确认入库。",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://creator.douyin.com/*", "https://www.douyin.com/*"],
  "action": {
    "default_title": "采集当前抖音页面",
    "default_popup": "popup.html"
  }
}
